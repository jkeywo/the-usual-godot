e": 70}]}}, {"id": "intention.attend_the_quiz", "display_name": "Get to the quiz", "source": "CommitmentDue", "conduct": "conduct.attend", "commitment_bonus": 20, "curve": {"points": [{"input": -120, "score": 150}, {"input": 0, "score": 150}, {"input": 30, "score": 90}, {"input": 45, "score": 20}, {"input": 46, "score": 0}, {"input": 240, "score": 0}]}, "modifiers": [{"when": "AnotherAttendeeIsDisapprovedOf", "delta": -60}]}, {"id": "intention.play_your_part", "display_name": "Do your bit", "source": "HoldingARole", "conduct": "conduct.play_your_part", "commitment_bonus": 20, "curve": {"points": [{"input": 0, "score": 0}, {"input": 99, "score": 0}, {"input": 100, "score": 70}]}}, {"id": "intention.get_the_shopping", "display_name": "Get the shopping", "source": {"kind": "CupboardRunningLow", "value": "object.cottage_larder"}, "conduct": "conduct.get_the_shopping", "commitment_bonus": 20, "curve": {"points": [{"input": 0, "score": 0}, {"input": 49, "score": 0}, {"input": 50, "score": 15}, {"input": 80, "score": 60}, {"input": 100, "score": 95}]}}]}
